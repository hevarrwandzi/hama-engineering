# Server Configuration
PORT=3000

# AWS S3 Configuration (Optional - set these when deploying to AWS)
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=hama-engineering-videos
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# AWS CloudFront Domain (Optional - set if using CloudFront CDN in front of S3)
CLOUDFRONT_DOMAIN=d1111111111111.cloudfront.net
